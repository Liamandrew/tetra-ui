{
  "name": "tetra-ui",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check:lint": "npx ultracite check",
    "check:types": "turbo run check:types",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:example": "turbo run dev --filter=example",
    "fix:lint": "npx ultracite fix",
    "registry:build": "turbo run registry:build --filter=docs",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "husky": "^9.1.7",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "ultracite": "8.1.0"
  },
  "packageManager": "pnpm@12.3.1",
  "engines": {
    "node": ">=18"
  }
}

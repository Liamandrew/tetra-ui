{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "moduleSuffixes": [".ios", ".android", ""],
    "paths": {
      "@/registry/ui/*": ["./src/components/*"],
      "@/registry/lib/*": ["./src/lib/*"],
      "@/registry/hooks/*": ["./src/hooks/*"]
    }
  },
  "include": [".", "uniwind-types.d.ts"],
  "exclude": ["node_modules", "dist"]
}
